// Recursos del ejecutable (sesion 28, como en GH): icono propio (tools/make_icon.py), version y autoria.
// Se compila con llvm-rc a ng2.res (tools\build_game.bat) sin cabeceras de Windows.
// Constantes de winver.h: VS_VERSION_INFO = 1, VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1.
// La version debe coincidir con AppVersion() de runtime/updater.cpp.

1 ICON "ng2.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Piscacho"
            VALUE "FileDescription", "Ninja Gaiden II - recompilacion para PC"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "NG2"
            VALUE "LegalCopyright", "(c) 2026 Piscacho - licencia MIT (https://github.com/Piscacho/Ninja-Gaiden-2-PC)"
            VALUE "OriginalFilename", "NG2.exe"
            VALUE "ProductName", "Ninja Gaiden II PC (recompilacion estatica, no oficial)"
            VALUE "ProductVersion", "1.0.0"
            VALUE "Comments", "Requiere el ISO original de Xbox 360. No contiene archivos del juego."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
